[TEMPLATE]
[TEMPLATE]
# Copy to .env.local and fill in real values. .env.local is gitignored; never
# commit the real key. See .freebuff/run.md for how the server consumes this.
STRIPE_RESTRICTED_API_KEY=rk_live_xxx

# Optional — branded order-confirmation emails (free tier, no card needed):
# https://resend.com → API Keys → add key. Without it, emails fall back to the
# free FormSubmit service (same as the contact form) as plain table emails.
RESEND_API_KEY=re_xxx

# Until a domain is verified at resend.com/domains, emails can only be delivered
# to the account owner's own address. Once you verify a domain (e.g. lumen.co.uk),
# set the from address to an email on it and every customer inbox receives mail.
# RESEND_FROM_EMAIL=hello@lumen.co.uk
# RESEND_FROM_NAME=LUMEN Digital Experiences

# Second provider for customer delivery WITHOUT domain/DNS verification:
# https://brevo.com → free plan (300 emails/day) → Senders → add & verify your
# sender email (click the link they email you — no DNS needed) → SMTP & API →
# API key. When Resend blocks a customer address, the email is sent via Brevo
# instead. Also used as the primary customer channel if RESEND_API_KEY is absent.
# In this project the account's already-verified sender is nathaniel.j.shaw@outlook.com.
# BREVO_API_KEY=xkeysib-xxx
# BREVO_SENDER_EMAIL=nathaniel.j.shaw@outlook.com
# BREVO_SENDER_NAME=LUMEN Digital Experiences

# Optional — automatic WhatsApp messages on status change (free tier, no Twilio):
# https://developers.facebook.com → create a Business app → add WhatsApp → link a
# WhatsApp Business number → API Setup shows a permanent access token and the
# Phone number ID. With these set, status changes (In Progress → "Work started",
# Ready for Review → demo link, Delivered → "Delivered") also send a WhatsApp
# message to customers who opted in, alongside the branded email.
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Optional — "Continue with Google" on the login / register pages (free):
# https://console.cloud.google.com → create a project → OAuth consent screen
# (External, add your email) → Credentials → Create OAuth client ID → Web app →
# Authorized redirect URIs: https://yourdomain.com/api/auth/google/callback
# (use http://localhost:8080/api/auth/google/callback for local dev).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
